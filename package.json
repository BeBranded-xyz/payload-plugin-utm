{
  "name": "payload-plugin-utm",
  "version": "0.2.0",
  "description": "Campaign links, live UTM generation, CSV exports and opt-in UTM-based content personalization for Payload CMS 3.",
  "type": "module",
  "license": "MIT",
  "author": "BeBranded",
  "repository": {
    "type": "git",
    "url": "https://github.com/BeBranded-xyz/payload-plugin-utm.git"
  },
  "homepage": "https://github.com/BeBranded-xyz/payload-plugin-utm#readme",
  "bugs": {
    "url": "https://github.com/BeBranded-xyz/payload-plugin-utm/issues"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "utm",
    "campaign",
    "marketing",
    "analytics",
    "personalization"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./utilities": {
      "types": "./dist/utilities.d.ts",
      "import": "./dist/utilities.js",
      "default": "./dist/utilities.js"
    },
    "./personalization": {
      "types": "./dist/personalization/match.d.ts",
      "import": "./dist/personalization/match.js",
      "default": "./dist/personalization/match.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./tracker": {
      "types": "./dist/tracker.d.ts",
      "import": "./dist/tracker.js",
      "default": "./dist/tracker.js"
    },
    "./rsc": {
      "types": "./dist/rsc.d.ts",
      "import": "./dist/rsc.js",
      "default": "./dist/rsc.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm build",
    "format": "prettier --write src tests examples package.json tsconfig*.json"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "peerDependencies": {
    "@payloadcms/next": "^3.92.0",
    "@payloadcms/ui": "^3.92.0",
    "next": ">=15.0.0",
    "payload": "^3.92.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@payloadcms/next": "3.92.0",
    "@payloadcms/plugin-multi-tenant": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "next": "16.3.3",
    "payload": "3.92.0",
    "prettier": "3.4.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  },
  "peerDependenciesMeta": {
    "@payloadcms/next": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  }
}
